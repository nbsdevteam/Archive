{
  "name": "template-new",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss",
    "**/*.css",
    "**/*.scss",
    "src/i18n/config.ts",
    "src/shared/stores/themeColorStore.ts",
    "src/shared/stores/layoutStore.ts",
    "src/assets/js/bootstrap.bundle.min.js"
  ],
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "rimraf dist && tsc -b && vite build",
    "build:prod": "npm run lint && rimraf dist && tsc -b && vite build",
    "build:analyze": "npm run build && node scripts/analyze-bundle.js",
    "build:bootstrap-rtl": "rtlcss public/assets/css/bootstrap.min.css public/assets/css/bootstrap.rtl.min.css",
    "analyze": "node scripts/analyze-bundle.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "performance": "npm run build:analyze",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:run": "vitest run",
    "trigger-apis": "node scripts/trigger-archive-apis.js",
    "cypress:run:headed": "cypress run --headed --browser chrome",
    "e2e:open": "cypress open",
    "e2e:slow:open": "cypress open --e2e --config specPattern=cypress/e2e/*slow*.cy.ts",
    "e2e:slow:ui": "start-server-and-test dev http://localhost:3003 \"cypress open --e2e --config specPattern=cypress/e2e/*slow*.cy.ts\"",
    "e2e:headed": "start-server-and-test dev http://localhost:3003 cypress:run:headed",
    "e2e:ci": "start-server-and-test dev http://localhost:3003 \"cypress run\"",
    "e2e:slow": "start-server-and-test dev http://localhost:3003 \"cypress run --headed --browser chrome --env commandDelay=600 --spec cypress/e2e/walkthrough-slow.cy.ts\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@hookform/resolvers": "^3.9.4",
    "@jridgewell/sourcemap-codec": "^1.5.5",
    "@nbs/component-library": "github:syednaqvi98nibras/StoryBook#latest",
    "@xyflow/react": "^12.10.0",
    "axios": "^1.13.4",
    "clsx": "^2.1.1",
    "i18next": "^24.2.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "libphonenumber-js": "^1.12.36",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-apexcharts": "^1.8.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.0.0",
    "react-focus-lock": "^2.13.7",
    "react-hook-form": "^7.56.4",
    "react-i18next": "^15.1.0",
    "react-perfect-scrollbar": "^1.5.8",
    "react-quill-new": "^3.6.0",
    "react-select": "^5.10.2",
    "react-toastify": "^10.0.6",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
